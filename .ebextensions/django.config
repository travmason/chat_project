option_settings:
  aws:elasticbeanstalk:container:python:
    WSGIPath: chat_project.wsgi:application

container_commands:
  01_create_log_dir:
    command: |
      mkdir -p /var/log/rolegenie
      chown webapp:webapp /var/log/rolegenie
      chmod 0755 /var/log/rolegenie

  05_migrate:
    command: "source /var/app/venv/*/bin/activate && python3 manage.py migrate --no-input"
    leader_only: true

  10_create_superuser:
    command: "source /var/app/venv/*/bin/activate && python3 manage.py ensure_adminuser --no-input"
    leader_only: true

  20_collectstatic:
    command: "source /var/app/venv/*/bin/activate && python manage.py collectstatic --noinput"
    leader_only: true