option_settings:
  aws:elasticbeanstalk:container:python:
    WSGIPath: chat_project.wsgi:application

container_commands:
  05_migrate:
    command: "python3 manage.py migrate --no-input"
    leader_only: true

  10_create_superuser:
    command: "source /var/app/venv/*/bin/activate && python3 manage.py ensure_adminuser --no-input"
    leader_only: true

  20_collectstatic:
    command: "source /var/app/venv/*/bin/activate && python3 manage.py collectstatic --noinput"
    leader_only: true